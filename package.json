{
  "name": "linguaflow-video-learning-assistant",
  "version": "0.1.0",
  "description": "基于 Next.js 与 Supabase 的视频学习进度、笔记和播放列表管理工具。",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev --turbopack --port 5566",
    "build": "next build",
    "start": "next start --port 5566",
    "create:project": "bash scripts/create-project.sh",
    "setup:project": "bash scripts/setup-project.sh",
    "setup:supabase": "node scripts/configure-supabase.mjs",
    "generate:vocabulary-packs": "node scripts/generate-vocabulary-packs.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link",
    "supabase:db:push": "supabase db push --linked",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "validate:deployment-env": "node scripts/validate-deployment-env.mjs",
    "vercel:build": "pnpm validate:deployment-env && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
